ORISON_CONFIG=config.toml
ORISON_HOST=127.0.0.1
ORISON_PORT=8765

# Set ORISON_API_TOKEN to a strong random value when binding Core to a non-loopback host.
# Go channels automatically forward this variable as the Core API bearer credential.

# Set ORISON_WEBHOOK_TOKEN to a strong random value before exposing the HTTP webhook channel.

# Optional request body cap for Core HTTP JSON requests (bytes, max 64 MiB).
ORISON_MAX_BODY_BYTES=8388608
