ORISON_CONFIG=config.toml
ORISON_HOST=127.0.0.1
ORISON_PORT=8765

# Orison uses Asia/Singapore (UTC+08:00), independent of the host timezone.
# Dream runs daily at 03:00 Singapore time.
ORISON_DREAM_DAILY_SCHEDULE=daily:03:00

# Supply DEEPSEEK_API_KEY privately in Core's process environment for API failover.
# Orison does not automatically load this file.

# Set ORISON_API_TOKEN to a strong random value when binding Core to a non-loopback host.
# Go channels automatically forward this variable as the Core API bearer credential.

# Set ORISON_WEBHOOK_TOKEN to a strong random value before exposing the HTTP webhook channel.

# QQ proactive messages and reminders use the OneBot HTTP endpoint.
# ORISON_ONEBOT_HTTP_URL defaults to http://127.0.0.1:15150.
# Supply ORISON_ONEBOT_ACCESS_TOKEN privately if the endpoint requires authentication.

# Optional request body cap for Core HTTP JSON requests (bytes, max 64 MiB).
ORISON_MAX_BODY_BYTES=8388608
